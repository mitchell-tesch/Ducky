<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <NoWarn>NU1701</NoWarn>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Ducky</AssemblyName>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <Target Name="GenerateGha" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFiles="$(OutputPath)$(AssemblyName).gha" />
  </Target>

  <PropertyGroup>
    <Version>0.4.0</Version>
    <Title>Ducky — DuckDB for Grasshopper</Title>
    <Authors>Mitchell Tesch</Authors>
    <Company>Ducky</Company>
    <Description>DuckDB integration for Grasshopper. Open in-memory or file-backed databases, load CSV/JSON/Parquet/Excel and Grasshopper data trees, query in SQL, export results, and round-trip Rhino geometry through the DuckDB spatial extension. Also provides fast, COM-free direct Excel read/write components for cell- and range-level access to xlsx/xlsm workbooks.</Description>
    <PackageProjectUrl>https://github.com/mitchell-tesch/Ducky</PackageProjectUrl>
    <PackageLicenseUrl>https://github.com/mitchell-tesch/Ducky/LICENSE</PackageLicenseUrl>
    <PackageTags>duckdb;sql;database;data;rhino;grasshopper;parquet;csv;excel;xlsx;xlsm;spreadsheet;openxml;spatial;wkb;analytics</PackageTags>
    <RepositoryUrl>https://github.com/mitchell-tesch/Ducky</RepositoryUrl>
    <Copyright>Copyright © Mitchell Tesch</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="8.0.23304.9001" ExcludeAssets="runtime" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.27" />
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.3" />
    <!--
      Excel components (Ducky Excel Read / Write / Info) — deliberately COM-free.

      MiniExcel.OpenXml (Apache-2.0) drives the *read* path: it streams xlsx
      without loading the workbook into memory and natively supports A1 range
      reads, open-ended ranges, sheet dimensions and typed cell values.
      Referenced directly rather than via the `MiniExcel` metapackage so the
      unused CSV provider is not shipped in the .gha.

      DocumentFormat.OpenXml (MIT) drives the *write* path. MiniExcel cannot
      modify an existing sheet without destroying it (its only write verbs
      replace a whole sheet or file), so anchored, style-preserving in-place
      cell writes are done through the OpenXML SDK instead.
    -->
    <PackageReference Include="MiniExcel.OpenXml" Version="2.0.0-preview.4" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GhDucky.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../yak/manifest.yml" CopyToOutputDirectory="PreserveNewest" Link="manifest.yml" />
    <None Include="../yak/icon.png" CopyToOutputDirectory="PreserveNewest" Link="icon.png"/>
  </ItemGroup>

  <!--
    `dotnet test` builds this project as a dependency with EnableDynamicLoading
    set to false, which strips the dependency DLLs and native runtimes from the
    output. Packaging that would yield a ~0.2 MB yak that installs cleanly and
    then fails at runtime, so skip packaging entirely unless the output is the
    full, dynamically-loadable plugin.
  -->
  <PropertyGroup>
    <ShouldPackageYak Condition="'$(Configuration)' == 'Release' and '$(EnableDynamicLoading)' == 'true'">true</ShouldPackageYak>
  </PropertyGroup>

  <!--
    Rhino 8 ships for Windows and macOS only, but DuckDB.NET.Data.Full carries
    native binaries for linux-x64 and linux-arm64 as well. Those two account for
    ~42 MB of the compressed package and can never be loaded by Rhino.

    The Yak server rejects uploads over 100 MB with an opaque HTTP 500, so the
    full five-runtime package (~103 MB) cannot be published at all. Pruning the
    unusable Linux natives brings it to ~61 MB.
  -->
  <Target Name="RemoveUnusedRuntimes" AfterTargets="Build" BeforeTargets="BuildYakPackage" Condition="'$(ShouldPackageYak)' == 'true'">
    <ItemGroup>
      <UnusedRuntimeFiles Include="$(OutputPath)runtimes\linux-*\**\*" />
    </ItemGroup>
    <Delete Files="@(UnusedRuntimeFiles)" />
    <RemoveDir Directories="$(OutputPath)runtimes\linux-x64;$(OutputPath)runtimes\linux-arm64" />
  </Target>

  <Target Name="BuildYakPackage" AfterTargets="Build" Condition="'$(ShouldPackageYak)' == 'true'">
    <PropertyGroup>
      <YakExecutable Condition="$(YakExecutable) == '' and $([MSBuild]::IsOSPlatform(windows)) and Exists('C:\Program Files\Rhino 8\System\Yak.exe')">C:\Program Files\Rhino 8\System\Yak.exe</YakExecutable>
      <YakExecutable Condition="$(YakExecutable) == '' and $([MSBuild]::IsOSPlatform(macos)) and Exists('/Applications/Rhino 8.app/Contents/Resources/bin/yak')">/Applications/Rhino 8.app/Contents/Resources/bin/yak</YakExecutable>

      <BuildYakPackage Condition="$(BuildYakPackage) == '' and $(YakExecutable) != '' and Exists($(YakExecutable))">True</BuildYakPackage>
    </PropertyGroup>

    <Warning Text="Could not find Yak executable" Condition="$(YakExecutable) == ''" />

    <ItemGroup>
          <YakPackagesToDelete Include="$(OutputPath)\*.yak" />
    </ItemGroup>

    <Delete Files="@(YakPackagesToDelete)" />

    <Exec Command="&quot;$(YakExecutable)&quot; build" WorkingDirectory="$(OutputPath)" Condition="$(BuildYakPackage) == 'True'" />

    <!--
      Two failure modes have bitten this project, both silent:

      1. `dotnet test` rebuilds this project with EnableDynamicLoading=false,
         which strips the dependency DLLs and native runtimes from bin/. A yak
         build straight afterwards produces a ~0.2 MB package that installs
         cleanly and then fails at runtime. Always rebuild before packaging.
      2. The Yak server rejects packages over 100 MB with an opaque HTTP 500.

      Catch both here, at build time, rather than after a bad upload.

      Implemented as a PowerShell Exec because MSBuild has no allowlisted
      property function for reading a file's size. Guarded to Windows, which is
      where releases are cut; on CI the Yak executable is absent so neither this
      target nor the check runs.
    -->
    <Exec Condition="$(BuildYakPackage) == 'True' and $([MSBuild]::IsOSPlatform(windows))"
          Command="powershell -NoProfile -Command &quot;$p = Get-ChildItem '$(OutputPath)*.yak' | Select-Object -First 1; if (-not $p) { Write-Error 'No .yak package was produced.'; exit 1 }; $mb = [math]::Round($p.Length/1MB, 2); $n = $p.Name; if ($p.Length -lt 10MB) { Write-Error (\&quot;Yak package is only $mb MB - dependencies are missing. This happens after 'dotnet test' strips bin/. Run: dotnet build GhDucky/GhDucky.csproj -c Release\&quot;); exit 1 }; if ($p.Length -gt 100MB) { Write-Error (\&quot;Yak package is $mb MB, over the 100 MB Yak server limit. The upload will fail with an opaque HTTP 500.\&quot;); exit 1 }; Write-Host (\&quot;Yak package OK: $n - $mb MB\&quot;)&quot;" />

  </Target>

</Project>
